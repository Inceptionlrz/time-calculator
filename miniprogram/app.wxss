/* app.wxss —— 全局样式（页面复用） */
page {
  background-color: #f5f7fa;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 26rpx;
  color: #8a8f99;
  margin-bottom: 16rpx;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
  font-size: 30rpx;
}

.picker-arrow {
  color: #9ca3af;
  font-size: 24rpx;
}

.btn-primary {
  background: #2563eb;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
  margin: 20rpx;
}

.btn-primary:active {
  background: #1d4ed8;
}
